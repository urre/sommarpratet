---
import Avatar from './Avatar.astro';
import AddToCalendar from './AddToCalendar.astro';
import { formatDate, isoDate, monthName } from '../lib/sommarpratare';
import { categorize, type Category } from '../lib/category';
import {
  instagramLink,
  chatgptLink,
  wikipediaLink,
  srLink,
  srEpisodeId,
} from '../lib/links';
import type { Host } from '../lib/sommarpratare';
import styles from './SommarTable.module.css';

interface Props {
  hosts: Host[];
}
const { hosts } = Astro.props;

const monthsPresent = [...new Set(hosts.map((h) => h.data.date.getUTCMonth() + 1))].sort((a, b) => a - b);

// Seasons present, newest first. The newest one is "this year" — it owns the
// Kommande/Sänts split; every earlier season gets its own tab.
const years = [...new Set(hosts.map((h) => h.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const currentYear = years[0];
const pastYears = years.slice(1);

// Static inline icons (kept as strings so the action row renders in one loop).
const IG_SVG =
  '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>';
const SHARE_SVG =
  '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>';
const CHATGPT_SVG =
  '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7493-7.073zM13.2599 22.43a4.4764 4.4764 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zM3.6 18.3036a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071.0061L4.0428 13.948a4.504 4.504 0 0 1-1.702-6.0525zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071-.006l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0801.0801 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z"/></svg>';
const SR_SVG =
  '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5a9 9 0 0 1 18 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>';
const HEART_SVG =
  '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8z"/></svg>';
const PLAY_SVG =
  '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';

// Build-time broadcast-window check, reused for the tab counts and for the
// initial visibility of the listen buttons. The client recomputes both live.
const buildNow = Date.now();
const airState = (date: Date, time: string) => {
  const [bh, bm] = time.split(':').map((n) => Number.parseInt(n, 10));
  const start = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate(), bh || 13, bm || 0);
  const end = start + 90 * 60 * 1000;
  return { past: end <= buildNow, live: buildNow >= start && buildNow < end };
};

// Precompute a view-model per host (no template literals in the template body —
// the Astro compiler can't parse `${...}` inside element expressions).
const rows = hosts.map((h) => {
  const name = h.data.name;
  const description = h.data.description ?? '';
  const date = h.data.date;
  const iso = isoDate(date);
  const monthFull = monthName(date.getUTCMonth() + 1).toLowerCase();
  const dateLabel = formatDate(date);
  const cat = categorize(description);

  // Searchable haystack: name + role + category + several date spellings so the
  // quick search matches "komiker", "juni", "20 juli", "2026-08-16", "16 aug"…
  const search = [
    name,
    description,
    cat.label,
    iso,
    dateLabel,
    date.getUTCDate() + ' ' + monthFull,
    monthFull,
  ]
    .join(' ')
    .toLowerCase();

  const actions: Array<{
    href?: string;
    title: string;
    label: string;
    svg?: string;
    text?: string;
    share?: boolean;
    shareTitle?: string;
    shareUrl?: string;
  }> = [
    { href: srLink(name, h.data.sr), title: 'Sveriges Radio', label: name + ' på Sveriges Radio', svg: SR_SVG },
    { href: instagramLink(name, h.data.instagram), title: 'Instagram', label: name + ' på Instagram', svg: IG_SVG },
    {
      share: true,
      title: 'Dela',
      label: 'Dela ' + name,
      svg: SHARE_SVG,
      shareTitle: 'Sommar i P1: ' + name,
      shareUrl: h.data.sr ?? '',
    },
    { href: chatgptLink(name), title: 'Fråga ChatGPT', label: 'Fråga ChatGPT om ' + name, svg: CHATGPT_SVG },
    { href: wikipediaLink(name, h.data.wikipedia), title: 'Wikipedia', label: name + ' på Wikipedia', text: 'W' },
  ];

  const time = h.data.time ?? '13:00';
  const air = airState(date, time);

  return {
    id: h.id,
    name,
    description,
    date,
    image: h.data.image,
    iso,
    year: date.getUTCFullYear(),
    month: iso.slice(5, 7),
    dateLabel,
    time,
    past: air.past,
    live: air.live,
    cat,
    search,
    actions,
    // Only episodes with a known SR episode id can be resolved to an mp3.
    episodeId: srEpisodeId(h.data.sr),
    playMeta: 'Sommar i P1 · ' + dateLabel,
    // A live broadcast isn't in the podcast feed yet — that one links out to SR.
    srHref: srLink(name, h.data.sr),
  };
});

// Build-time upcoming/past split — of *this year's* season only; earlier
// seasons live behind their own tabs. Rendered into the tab counts + result
// count so the first paint matches what the client computes (no CLS).
const currentRows = rows.filter((r) => r.year === currentYear);
const pastCount = currentRows.filter((r) => r.past).length;
const upcomingCount = currentRows.length - pastCount;
const yearCounts = new Map<number, number>();
for (const r of rows) yearCounts.set(r.year, (yearCounts.get(r.year) ?? 0) + 1);

// Once the season is over "Kommande" is empty, so open on "Sänts" instead.
const initialTab = upcomingCount > 0 ? 'upcoming' : 'past';
const inInitialTab = (r: (typeof rows)[number]) =>
  r.year === currentYear && (initialTab === 'past' ? r.past : !r.past);
const initialRows = rows.filter(inInitialTab);
const initialCount = initialRows.length + ' sommarpratare';

// Every category present across all seasons (the option list is stable as you
// switch tabs); the counts are for the tab shown first and are recomputed
// client-side whenever the active tab or the other filters change.
const categories: Category[] = [];
for (const r of rows) if (!categories.some((c) => c.key === r.cat.key)) categories.push(r.cat);
categories.sort((a, b) => a.label.localeCompare(b.label, 'sv'));
const catCounts = new Map<string, number>();
for (const r of initialRows) catCounts.set(r.cat.key, (catCounts.get(r.cat.key) ?? 0) + 1);
---

<section class={styles.wrap} data-table data-current-year={String(currentYear)} data-initial-tab={initialTab}>
  <div class={styles.tabsRow}>
  <div class={styles.tabs} role="tablist" aria-label="Sändningsstatus och årgång" data-tabs>
    <button
      id="sp-tab-upcoming"
      type="button"
      class={styles.tab}
      role="tab"
      aria-selected={initialTab === 'upcoming' ? 'true' : 'false'}
      aria-controls="sp-results"
      tabindex={initialTab === 'upcoming' ? '0' : '-1'}
      data-tab="upcoming"
    >
      Kommande <span class={styles.tabCount} data-tab-count="upcoming">({upcomingCount})</span>
    </button>
    <button
      id="sp-tab-past"
      type="button"
      class={styles.tab}
      role="tab"
      aria-selected={initialTab === 'past' ? 'true' : 'false'}
      aria-controls="sp-results"
      tabindex={initialTab === 'past' ? '0' : '-1'}
      data-tab="past"
    >
      Sänts <span class={styles.tabCount} data-tab-count="past">({pastCount})</span>
    </button>
    <button id="sp-tab-favorites" type="button" class={styles.tab} role="tab" aria-selected="false" aria-controls="sp-results" tabindex="-1" data-tab="favorites">
      Favoriter <span class={styles.tabCount} data-tab-count="favorites">(0)</span>
    </button>

    {pastYears.length > 0 && <span class={styles.tabsDivider} aria-hidden="true"></span>}
    {pastYears.map((y) => (
      <button
        id={'sp-tab-year-' + y}
        type="button"
        class={styles.tab + ' ' + styles.tabYear}
        role="tab"
        aria-selected="false"
        aria-controls="sp-results"
        tabindex="-1"
        aria-label={'Sommarpratare ' + y}
        data-tab={'year:' + y}
      >
        {y} <span class={styles.tabCount}>({yearCounts.get(y)})</span>
      </button>
    ))}
  </div>

    <button
      type="button"
      class={styles.shareTab}
      data-share-tab
      data-tip="Dela vyn"
      aria-label="Dela den här vyn"
    >
      <Fragment set:html={SHARE_SVG} />
    </button>
  </div>

  <div class={styles.toolbar}>
    <div class={styles.searchCol}>
      <div class={styles.searchField}>
        <svg
          class={styles.searchIcon}
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.3-4.3"></path>
        </svg>
        <input
          type="search"
          class={styles.search}
          data-search
          placeholder="Sök namn, kategori eller datum…"
          aria-label="Sök sommarpratare"
          autocomplete="off"
        />
      </div>
      <div class={styles.meta}>
        <p class={styles.count} data-count aria-live="polite">{initialCount}</p>
        <button type="button" class={styles.clearBtn} data-clear hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          Rensa filter
        </button>
      </div>
    </div>

    <div class={styles.filters}>
      <div class={styles.filterField}>
        <label class="visually-hidden" for="month-filter">Filtrera på månad</label>
        <select id="month-filter" class={styles.select} data-month>
          <option value="">Hela sommaren</option>
          {monthsPresent.map((m) => (
            <option value={String(m).padStart(2, '0')}>{monthName(m)}</option>
          ))}
        </select>
      </div>

      <div class={styles.filterField}>
        <label class="visually-hidden" for="category-filter">Filtrera på kategori</label>
        <select id="category-filter" class={styles.select} data-category>
          <option value="">Alla kategorier</option>
          {categories.map((c) => (
            <option value={c.key} data-label={c.label} disabled={!catCounts.get(c.key)}>
              {c.label + ' (' + (catCounts.get(c.key) ?? 0) + ')'}
            </option>
          ))}
        </select>
      </div>

      <div class={styles.sortField}>
        <label class="visually-hidden" for="sort-select">Sortera</label>
        <select id="sort-select" class={styles.select} data-sort-select>
          <option value="date-asc">Datum (tidigast)</option>
          <option value="date-desc">Datum (senast)</option>
          <option value="name-asc">Namn (A–Ö)</option>
          <option value="name-desc">Namn (Ö–A)</option>
        </select>
      </div>

      <div class={styles.viewField}>
        <div class={styles.viewToggle} role="group" aria-label="Vy">
          <button type="button" class={styles.viewBtn} data-view-btn="list" aria-pressed="true" aria-label="Visa som lista">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="8" y1="6" x2="20" y2="6"></line>
              <line x1="8" y1="12" x2="20" y2="12"></line>
              <line x1="8" y1="18" x2="20" y2="18"></line>
              <line x1="4" y1="6" x2="4.01" y2="6"></line>
              <line x1="4" y1="12" x2="4.01" y2="12"></line>
              <line x1="4" y1="18" x2="4.01" y2="18"></line>
            </svg>
          </button>
          <button type="button" class={styles.viewBtn} data-view-btn="cards" aria-pressed="false" aria-label="Visa som kort">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class={styles.tableScroll} id="sp-results" role="tabpanel" aria-labelledby="sp-tab-upcoming" tabindex="0">
    <table class={styles.table}>
      <caption class="visually-hidden">
        Sommarpratare i Sommar i P1 – sorterbar tabell med datum, år, namn, beskrivning och länkar.
      </caption>
      <thead>
        <tr>
          <th scope="col" class={styles.thFav}><span class="visually-hidden">Favorit</span></th>
          <th scope="col" class={styles.thAvatar}><span class="visually-hidden">Bild</span></th>
          <th scope="col" class={styles.thDate} aria-sort="ascending">
            <button type="button" class={styles.sortBtn} data-sort="date">
              Datum <span class={styles.arrow} data-arrow aria-hidden="true">▲</span>
            </button>
          </th>
          <th scope="col" class={styles.thYear}>År</th>
          <th scope="col" class={styles.thStatus}><span class="visually-hidden">Status</span></th>
          <th scope="col" class={styles.thName}>
            <button type="button" class={styles.sortBtn} data-sort="name">
              Namn <span class={styles.arrow} data-arrow aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class={styles.thDesc}>Beskrivning</th>
          <th scope="col" class={styles.thLinks}>Länkar</th>
        </tr>
      </thead>
      <tbody data-rows>
        {rows.map((r) => (
          <tr
            class={styles.row}
            data-row
            hidden={!inInitialTab(r)}
            data-name={r.name.toLowerCase()}
            data-date={r.iso}
            data-time={r.time}
            data-year={String(r.year)}
            data-month={r.month}
            data-category={r.cat.key}
            data-search={r.search}
          >
            <td class={styles.cellFav}>
              <button type="button" class={styles.favBtn} data-fav data-id={r.id} aria-pressed="false" aria-label={'Spara ' + r.name + ' som favorit'}>
                <Fragment set:html={HEART_SVG} />
              </button>
            </td>
            <td class={styles.cellAvatar}>
              <Avatar name={r.name} image={r.image} size={52} preview />
            </td>
            <td class={styles.cellDate}>
              <time datetime={r.iso + 'T' + r.time}>{r.dateLabel}</time><span class={styles.yearLabel}>{r.year}</span>
              <span class={styles.timeLabel}>kl {r.time}</span>
            </td>
            <td class={styles.cellYear}>{r.year}</td>
            <td class={styles.cellStatus}>
              <span class={styles.statusPill} data-status-pill hidden>Idag</span>
            </td>
            <td class={styles.cellName}>{r.name}</td>
            <td class={styles.cellDesc}>{r.description}</td>
            <td class={styles.cellLinks}>
              <div class={styles.links}>
                {r.episodeId && (
                  <button
                    type="button"
                    class={styles.iconBtn + ' ' + styles.playRowBtn}
                    data-play
                    data-episode={r.episodeId}
                    data-host={r.name}
                    data-meta={r.playMeta}
                    data-image={r.image ?? ''}
                    data-tip="Lyssna"
                    aria-label={'Lyssna på ' + r.name}
                    aria-pressed="false"
                    hidden={!r.past}
                  >
                    <Fragment set:html={PLAY_SVG} />
                  </button>
                )}
                <a
                  class={styles.iconBtn + ' ' + styles.playRowBtn + ' ' + styles.playLiveBtn}
                  href={r.srHref}
                  target="_blank"
                  rel="noopener"
                  data-play-live
                  data-tip="Lyssna live"
                  aria-label={'Lyssna live på ' + r.name + ' hos Sveriges Radio'}
                  hidden={!r.live}
                >
                  <Fragment set:html={PLAY_SVG} />
                </a>
                {r.actions.map((a) =>
                  a.share ? (
                    <button
                      type="button"
                      class={styles.iconBtn}
                      data-share
                      data-share-title={a.shareTitle}
                      data-share-url={a.shareUrl}
                      data-tip={a.title}
                      aria-label={a.label}
                    >
                      <Fragment set:html={a.svg} />
                    </button>
                  ) : (
                    <a
                      class={styles.iconBtn}
                      href={a.href}
                      target="_blank"
                      rel="noopener"
                      data-tip={a.title}
                      aria-label={a.label}
                    >
                      {a.svg ? <Fragment set:html={a.svg} /> : <span class={styles.mono} aria-hidden="true">{a.text}</span>}
                    </a>
                  ),
                )}
                <AddToCalendar name={r.name} date={r.date} time={r.time} description={r.description} uid={r.id} variant="compact" />
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class={styles.noResults} data-no-results hidden>Inga sommarpratare matchar din sökning.</p>
  </div>
</section>

<script>
  // Small play glyph for the "Live" pill.
  const PLAY =
    '<svg aria-hidden="true" width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';

  function initTable() {
    const rootEl = document.querySelector<HTMLElement>('[data-table]');
    if (!rootEl) return;
    // Rebound as non-nullable so the narrowing survives into the closures below.
    const root: HTMLElement = rootEl;
    const search = root.querySelector<HTMLInputElement>('[data-search]');
    const monthSel = root.querySelector<HTMLSelectElement>('[data-month]');
    const categorySel = root.querySelector<HTMLSelectElement>('[data-category]');
    const tbody = root.querySelector<HTMLElement>('[data-rows]');
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
    const count = root.querySelector<HTMLElement>('[data-count]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]');
    const noResults = root.querySelector<HTMLElement>('[data-no-results]');
    const sortBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-sort]'));
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort-select]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const tabStrip = root.querySelector<HTMLElement>('[data-tabs]');
    const shareTabBtn = root.querySelector<HTMLButtonElement>('[data-share-tab]');
    const panel = root.querySelector<HTMLElement>('#sp-results');
    const upCount = root.querySelector<HTMLElement>('[data-tab-count="upcoming"]');
    const pastCount = root.querySelector<HTMLElement>('[data-tab-count="past"]');
    const favCountEl = root.querySelector<HTMLElement>('[data-tab-count="favorites"]');
    const favBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-fav]'));
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view-btn]'));
    if (!tbody) return;

    const FAV_KEY = 'sommarpratet:favorites';
    const VIEW_KEY = 'sommarpratet:view';
    let favSet = new Set<string>();
    try {
      favSet = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]'));
    } catch (e) {}

    let sortKey: 'date' | 'name' = 'date';
    let sortDir = 1; // 1 = ascending, -1 = descending
    // 'upcoming' | 'past' | 'favorites' | 'year:2025' — the three status tabs
    // cover the current season, each earlier season gets a 'year:' tab.
    const currentYear = root.dataset.currentYear ?? '';
    const initialTab = root.dataset.initialTab ?? 'upcoming';
    let activeTab = initialTab;

    // Broadcast window (local time) per row — computed live so the static build
    // stays correct and rows move from "På gång" to "Har sänts" on their own.
    const DURATION_MS = 90 * 60 * 1000;
    function startEnd(row: HTMLElement) {
      const [Y, M, D] = (row.dataset.date ?? '').split('-').map(Number);
      const [h, mi] = (row.dataset.time ?? '13:00').split(':').map(Number);
      const start = new Date(Y, (M || 1) - 1, D || 1, h || 13, mi || 0).getTime();
      return { start, end: start + DURATION_MS };
    }
    const isPast = (row: HTMLElement) => startEnd(row).end <= Date.now();
    function isLive(row: HTMLElement) {
      const { start, end } = startEnd(row);
      const t = Date.now();
      return t >= start && t < end;
    }

    /** Does this row belong to the active tab, ignoring search + filters? */
    function inScope(row: HTMLElement) {
      if (activeTab.startsWith('year:')) return row.dataset.year === activeTab.slice(5);
      if (activeTab === 'favorites') return row.dataset.fav === '1';
      // Kommande/Sänts only ever describe the current season.
      if (row.dataset.year !== currentYear) return false;
      return activeTab === 'past' ? isPast(row) : !isPast(row);
    }

    function cmp(a: HTMLElement, b: HTMLElement) {
      const av = a.dataset[sortKey] ?? '';
      const bv = b.dataset[sortKey] ?? '';
      const r = sortKey === 'name' ? av.localeCompare(bv, 'sv') : av < bv ? -1 : av > bv ? 1 : 0;
      return r * sortDir;
    }

    function syncSortUI() {
      for (const btn of sortBtns) {
        const th = btn.closest('th');
        const arrow = btn.querySelector<HTMLElement>('[data-arrow]');
        const active = btn.dataset.sort === sortKey;
        if (th) {
          if (active) th.setAttribute('aria-sort', sortDir === 1 ? 'ascending' : 'descending');
          else th.removeAttribute('aria-sort');
        }
        if (arrow) arrow.textContent = active ? (sortDir === 1 ? '▲' : '▼') : '';
        btn.classList.toggle('is-active', active);
      }
      if (sortSelect) sortSelect.value = sortKey + '-' + (sortDir === 1 ? 'asc' : 'desc');
    }

    function saveFavs() {
      try {
        localStorage.setItem(FAV_KEY, JSON.stringify([...favSet]));
      } catch (e) {}
    }
    // Reflect the favourite set onto the heart buttons + rows + the tab count.
    function applyFavs() {
      for (const btn of favBtns) {
        const id = btn.dataset.id ?? '';
        const on = favSet.has(id);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        const row = btn.closest<HTMLElement>('[data-row]');
        if (row) {
          if (on) row.dataset.fav = '1';
          else delete row.dataset.fav;
        }
      }
      if (favCountEl) favCountEl.textContent = '(' + favSet.size + ')';
    }

    // Status pills (Idag / Live) + the "På gång / Har sänts" tab counts.
    function updateStatus() {
      const now = new Date();
      const pad = (n: number) => String(n).padStart(2, '0');
      const todayIso = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
      let up = 0;
      let past = 0;
      for (const row of rows) {
        const done = isPast(row);
        const live = isLive(row);
        // Kommande/Sänts count this season only — earlier seasons have their
        // own tabs and are past by definition.
        if (row.dataset.year === currentYear) {
          if (done) past++;
          else up++;
        }
        // In-page playback needs the podcast file, which only exists once the
        // episode has aired. While it's on air, link out to SR's live player.
        const playBtn = row.querySelector<HTMLElement>('[data-play]');
        if (playBtn) playBtn.hidden = !done;
        const liveBtn = row.querySelector<HTMLElement>('[data-play-live]');
        if (liveBtn) liveBtn.hidden = !live;
        const pill = row.querySelector<HTMLElement>('[data-status-pill]');
        if (!pill) continue;
        if (live) {
          row.dataset.live = 'true';
          pill.dataset.state = 'live';
          pill.innerHTML = PLAY + 'Live';
          pill.hidden = false;
        } else {
          delete row.dataset.live;
          if (row.dataset.date === todayIso && !done) {
            delete pill.dataset.state;
            pill.textContent = 'Idag';
            pill.hidden = false;
          } else {
            delete pill.dataset.state;
            pill.hidden = true;
          }
        }
      }
      if (upCount) upCount.textContent = '(' + up + ')';
      if (pastCount) pastCount.textContent = '(' + past + ')';
    }

    /** Category facet counts, so the dropdown reflects the tab you're on. */
    function syncCategoryCounts(counts: Map<string, number>) {
      if (!categorySel) return;
      for (const opt of Array.from(categorySel.options)) {
        if (!opt.value) continue;
        const n = counts.get(opt.value) ?? 0;
        opt.textContent = (opt.dataset.label ?? '') + ' (' + n + ')';
        // Never disable the active choice — that would strand the filter.
        opt.disabled = n === 0 && opt.value !== categorySel.value;
      }
    }

    function render() {
      const q = (search?.value ?? '').trim().toLowerCase();
      const m = monthSel?.value ?? '';
      const c = categorySel?.value ?? '';
      // A search or a filter looks across every season — the tab only sets the
      // default view. Favoriter is the exception: narrowing your own saved list
      // should never pull in people you didn't save.
      const crossYear = !!(q || m || c) && activeTab !== 'favorites';
      // Counted over everything but the category filter itself, so the numbers
      // read as "what picking this category would give me".
      const catCounts = new Map<string, number>();
      let shown = 0;
      let scopeTotal = 0;
      for (const row of [...rows].sort(cmp)) {
        const scoped = crossYear || inScope(row);
        if (scoped) scopeTotal++;
        const rest =
          scoped &&
          (!q || (row.dataset.search ?? '').includes(q)) &&
          (!m || row.dataset.month === m);
        if (rest) {
          const k = row.dataset.category ?? '';
          catCounts.set(k, (catCounts.get(k) ?? 0) + 1);
        }
        const visible = rest && (!c || row.dataset.category === c);
        row.hidden = !visible;
        if (visible) shown++;
        tbody!.appendChild(row); // re-append in sorted order
      }
      syncCategoryCounts(catCounts);
      if (count) {
        // The denominator is the active tab's total, not the whole archive —
        // unless a search/filter has widened the view to every season.
        count.textContent = crossYear
          ? shown + (shown === 1 ? ' träff' : ' träffar') + ' i alla säsonger'
          : shown === scopeTotal
            ? scopeTotal + ' sommarpratare'
            : shown + ' av ' + scopeTotal;
      }
      if (clearBtn) clearBtn.hidden = !(q || m || c);
      if (noResults) {
        noResults.hidden = shown !== 0;
        if (shown === 0) {
          noResults.textContent =
            activeTab === 'favorites' && scopeTotal === 0
              ? 'Inga favoriter än – tryck på hjärtat för att spara en sommarpratare.'
              : 'Inga sommarpratare matchar din sökning.';
        }
      }
      syncSortUI();
    }

    /** Keep the selected tab within view of the (scrollable) tab strip.
        Measured from bounding rects rather than offsetLeft — the strip isn't a
        positioned element, so offsetLeft is relative to something else. */
    function revealTab(t: HTMLElement) {
      if (!tabStrip) return;
      const pad = 16;
      const strip = tabStrip.getBoundingClientRect();
      const tab = t.getBoundingClientRect();
      if (tab.left < strip.left) tabStrip.scrollLeft -= strip.left - tab.left + pad;
      else if (tab.right > strip.right) tabStrip.scrollLeft += tab.right - strip.right + pad;
    }

    function selectTab(name: string, focus?: boolean) {
      activeTab = name;
      for (const t of tabs) {
        const sel = t.dataset.tab === name;
        t.setAttribute('aria-selected', sel ? 'true' : 'false');
        t.tabIndex = sel ? 0 : -1;
        if (sel) {
          if (panel) panel.setAttribute('aria-labelledby', t.id);
          if (focus) t.focus();
          revealTab(t);
        }
      }
      writeFilterUrl();
      render();
    }

    // Every tab + filter lives in the URL (?flik=&kategori=&manad=) so any view
    // is deep-linkable and shareable. The default tab is left implicit so the
    // untouched page shares as a bare "/".
    const TAB_TO_PARAM: Record<string, string> = {
      upcoming: 'kommande',
      past: 'sants',
      favorites: 'favoriter',
    };
    function writeFilterUrl() {
      const p = new URLSearchParams();
      if (activeTab !== initialTab) {
        p.set('flik', activeTab.startsWith('year:') ? activeTab.slice(5) : (TAB_TO_PARAM[activeTab] ?? activeTab));
      }
      const q = search?.value.trim();
      if (q) p.set('sok', q);
      if (categorySel?.value) p.set('kategori', categorySel.value);
      if (monthSel?.value) p.set('manad', monthSel.value);
      const qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
    }
    search?.addEventListener('input', () => {
      writeFilterUrl();
      render();
    });
    monthSel?.addEventListener('change', () => {
      writeFilterUrl();
      render();
    });
    categorySel?.addEventListener('change', () => {
      writeFilterUrl();
      render();
    });
    clearBtn?.addEventListener('click', () => {
      if (search) search.value = '';
      if (monthSel) monthSel.value = '';
      if (categorySel) categorySel.value = '';
      writeFilterUrl();
      render();
    });
    sortSelect?.addEventListener('change', () => {
      const [key, dir] = sortSelect.value.split('-');
      sortKey = key as 'date' | 'name';
      sortDir = dir === 'desc' ? -1 : 1;
      render();
    });
    for (const btn of sortBtns) {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort as 'date' | 'name';
        if (sortKey === key) sortDir *= -1;
        else {
          sortKey = key;
          sortDir = 1;
        }
        render();
      });
    }
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => selectTab(t.dataset.tab ?? 'upcoming'));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const dir = e.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        selectTab(next.dataset.tab ?? 'upcoming', true);
      });
    });

    // Share the current view. The URL already carries the tab + filters, so
    // this is just "share where I am" — named after the tab so the recipient
    // knows what they're opening.
    shareTabBtn?.addEventListener('click', async () => {
      const label = (tabs.find((t) => t.dataset.tab === activeTab)?.textContent ?? '')
        .replace(/\(\d+\)/, '')
        .replace(/\s+/g, ' ')
        .trim();
      const title = label ? 'Sommarpratet – ' + label : 'Sommarpratet';
      const url = location.href;
      try {
        if (navigator.share) {
          await navigator.share({ title, text: title, url });
        } else if (navigator.clipboard) {
          await navigator.clipboard.writeText(url);
          shareTabBtn.dataset.tip = 'Länk kopierad';
          window.setTimeout(() => {
            shareTabBtn.dataset.tip = 'Dela vyn';
          }, 1500);
        }
      } catch (e) {}
    });

    // Share — Web Share API, with a copy-link fallback where it's unsupported.
    for (const btn of Array.from(root.querySelectorAll<HTMLButtonElement>('[data-share]'))) {
      btn.addEventListener('click', async () => {
        const title = btn.dataset.shareTitle || document.title;
        const url = btn.dataset.shareUrl || location.href;
        try {
          if (navigator.share) {
            await navigator.share({ title, text: title, url });
          } else if (navigator.clipboard) {
            await navigator.clipboard.writeText(url);
            const prev = btn.dataset.tip;
            btn.dataset.tip = 'Länk kopierad';
            window.setTimeout(() => {
              btn.dataset.tip = prev || 'Dela';
            }, 1500);
          }
        } catch (e) {}
      });
    }

    // Favourites — toggle hearts, persist to localStorage.
    for (const btn of favBtns) {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id ?? '';
        if (favSet.has(id)) favSet.delete(id);
        else favSet.add(id);
        saveFavs();
        applyFavs();
        render();
      });
    }

    // View toggle (list / cards) — available on every screen. The initial state
    // is applied before first paint by an inline head script (saved choice wins;
    // mobile defaults to cards), so we just reflect it in the select and react to
    // explicit user changes (a user-initiated toggle doesn't count as CLS).
    function syncViewButtons() {
      const cards = document.documentElement.hasAttribute('data-cards');
      for (const b of viewBtns) {
        b.setAttribute('aria-pressed', (b.dataset.viewBtn === 'cards') === cards ? 'true' : 'false');
      }
    }
    for (const b of viewBtns) {
      b.addEventListener('click', () => {
        const cards = b.dataset.viewBtn === 'cards';
        try {
          localStorage.setItem(VIEW_KEY, cards ? 'cards' : 'list');
        } catch (e) {}
        document.documentElement.toggleAttribute('data-cards', cards);
        syncViewButtons();
      });
    }
    syncViewButtons();

    // Deep link: restore season + category + month from the URL on load
    // (?ar=, ?kategori=, ?manad=).
    const params = new URLSearchParams(location.search);
    const qParam = params.get('sok');
    if (qParam && search) search.value = qParam;
    const catParam = params.get('kategori');
    if (catParam && categorySel && [...categorySel.options].some((o) => o.value === catParam)) {
      categorySel.value = catParam;
    }
    const monthParam = params.get('manad');
    if (monthParam && monthSel && [...monthSel.options].some((o) => o.value === monthParam)) {
      monthSel.value = monthParam;
    }
    // ?flik=kommande|sants|favoriter|2025 — ?ar=2025 is kept as an alias.
    const PARAM_TO_TAB: Record<string, string> = {
      kommande: 'upcoming',
      sants: 'past',
      favoriter: 'favorites',
    };
    const flik = params.get('flik') ?? params.get('ar');
    const wantedTab = flik ? (PARAM_TO_TAB[flik] ?? (/^\d{4}$/.test(flik) ? 'year:' + flik : '')) : '';

    applyFavs();
    updateStatus();
    if (wantedTab && tabs.some((t) => t.dataset.tab === wantedTab)) selectTab(wantedTab);
    else render();

    // The webfont lands after the first layout pass and changes tab widths, so
    // the initial reveal has to be redone once things have settled.
    const revealActive = () => {
      const t = tabs.find((x) => x.dataset.tab === activeTab);
      if (t) revealTab(t);
    };
    requestAnimationFrame(revealActive);
    document.fonts?.ready.then(revealActive).catch(() => {});
    // Re-evaluate live state + tab membership over time (e.g. 13:00 → live).
    setInterval(() => {
      updateStatus();
      render();
    }, 30000);
  }

  if (document.readyState !== 'loading') initTable();
  else document.addEventListener('DOMContentLoaded', initTable);
</script>
