---
import { initials, avatarColor, textColor } from '../lib/avatar';
import styles from './Avatar.module.css';

interface Props {
  name: string;
  /** Optional portrait image (path or URL). Falls back to an initials avatar. */
  image?: string;
  size?: number;
  /** Desktop-only: show a larger photo popover to the right on hover. */
  preview?: boolean;
}

const { name, image, size = 44, preview = false } = Astro.props;
const bg = avatarColor(name);
const fg = textColor(bg);
---

{image ? (
  <span class={styles.holder} style={`--av-fs:${Math.round(size * 0.36)}px`}>
    {/* Initials sit *under* every photo: visible while the lazy image is still
        loading (a tab switch reveals ~58 rows at once) and left in place if it
        never arrives at all. */}
    <span
      class={styles.fallback}
      data-avatar-fallback
      style={`background:${bg};color:${fg}`}
      aria-hidden="true"
    >{initials(name)}</span>
    <img
      class={styles.avatar}
      data-avatar-img
      src={image}
      alt={name}
      width={size}
      height={size}
      style={`width:${size}px;height:${size}px`}
      loading="lazy"
      decoding="async"
    />
    {preview && (
      <img class={styles.preview} data-avatar-img src={image} alt="" aria-hidden="true" loading="lazy" decoding="async" />
    )}
  </span>
) : (
  <span
    class={styles.avatar}
    style={`width:${size}px;height:${size}px;background:${bg};color:${fg};font-size:${Math.round(size * 0.36)}px`}
    aria-hidden="true"
  >{initials(name)}</span>
)}

<script>
  // Fade out any portrait that fails to load, leaving the initials layer
  // underneath visible. Bound up-front (not polled) because avatars are lazy
  // and only start loading when a tab switch or a scroll reveals their row.
  function bindAvatarFallbacks() {
    for (const img of Array.from(document.querySelectorAll<HTMLImageElement>('img[data-avatar-img]'))) {
      if (img.dataset.bound) continue;
      img.dataset.bound = '1';
      // An error may already have fired before this script ran.
      if (img.complete && img.naturalWidth === 0) img.dataset.failed = '1';
      else img.addEventListener('error', () => (img.dataset.failed = '1'), { once: true });
    }
  }

  if (document.readyState !== 'loading') bindAvatarFallbacks();
  else document.addEventListener('DOMContentLoaded', bindAvatarFallbacks);
</script>
