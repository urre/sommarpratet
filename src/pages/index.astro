---
import Layout from '../layouts/Layout.astro';
import SommarTable from '../components/SommarTable.astro';
import { getHosts, formatDate } from '../lib/sommarpratare';
import styles from './index.module.css';

const hosts = await getHosts();
const first = hosts[0]?.data.date;
const last = hosts[hosts.length - 1]?.data.date;
const year = first?.getUTCFullYear() ?? new Date().getUTCFullYear();

// ItemList structured data for the full line-up.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Sommarpratare ${year}`,
  numberOfItems: hosts.length,
  itemListElement: hosts.map((h, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'Person', name: h.data.name, description: h.data.description },
  })),
};
---

<Layout title="Sommarpratet" jsonLd={itemListSchema}>
  <header class={styles.hero}>
    <h1 class={styles.title}><a href="/" class={styles.titleLink}>Sommarpratet</a></h1>
    <p class={styles.lede}>
      Alla {hosts.length} sommarpratare i Sommar i P1 {year}
      {first && last && (
        <> – från {formatDate(first)} till {formatDate(last)}</>
      )}. Sök, sortera och lägg till sändningarna direkt i din kalender.
    </p>
  </header>

  <SommarTable hosts={hosts} />
</Layout>
