---
import Layout from '../layouts/Layout.astro';
import SommarTable from '../components/SommarTable.astro';
import Player from '../components/Player.astro';
import { getHosts, isoDate } from '../lib/sommarpratare';
import styles from './index.module.css';

const hosts = await getHosts();
// The table also carries earlier seasons (behind their own tabs), so "årets"
// is the newest season present, not the first row.
const year = hosts.reduce((y, h) => Math.max(y, h.data.date.getUTCFullYear()), 0) || new Date().getUTCFullYear();
const currentHosts = hosts.filter((h) => h.data.date.getUTCFullYear() === year);
const site = Astro.site ?? Astro.url;

// ItemList structured data for this year's line-up (the page's subject —
// earlier seasons are an archive and are left out to keep the payload small).
// Each Person carries their portrait, verified profiles (sameAs) and the
// Sommar i P1 episode (subjectOf).
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Sommarpratare i Sommar i P1 ${year}`,
  numberOfItems: currentHosts.length,
  itemListElement: currentHosts.map((h, i) => {
    const sameAs = [h.data.instagram, h.data.x, h.data.wikipedia].filter(Boolean);
    const person: Record<string, unknown> = { '@type': 'Person', name: h.data.name };
    if (h.data.description) person.description = h.data.description;
    if (h.data.image) person.image = new URL(h.data.image, site).href;
    if (sameAs.length) person.sameAs = sameAs;
    if (h.data.sr) {
      person.subjectOf = {
        '@type': 'RadioEpisode',
        name: `Sommar i P1: ${h.data.name}`,
        url: h.data.sr,
        datePublished: isoDate(h.data.date),
        partOfSeries: { '@type': 'RadioSeries', name: 'Sommar i P1' },
      };
    }
    return { '@type': 'ListItem', position: i + 1, item: person };
  }),
};
---

<Layout title="Sommarpratet" jsonLd={itemListSchema}>
  <header class={styles.hero}>
    <h1 class={styles.title}><a href="/" class={styles.titleLink}>Sommarpratet</a></h1>
    <p class={styles.lede}>
      En lite bättre översikt över årets sommarpratare – och arkivet från tidigare
      somrar. Spara dina favoriter och lägg till sändningarna direkt i din kalender.
    </p>
  </header>

  <SommarTable hosts={hosts} />
  <Player />
</Layout>
