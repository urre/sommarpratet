---
import '../styles/global.css';
import styles from './Layout.module.css';

interface Props {
  title: string;
  description?: string;
  /** Page-specific JSON-LD structured data object(s). */
  jsonLd?: object | object[];
}

const {
  title,
  description = 'Sommarpratet i Sommar i P1 – datum, beskrivningar och länkar i en sökbar, sorterbar lista.',
  jsonLd,
} = Astro.props;

const siteName = 'Sommarpratet';
const fullTitle = title === siteName ? title : `${title} – ${siteName}`;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.jpg', site);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: new URL('/', site).href,
  inLanguage: 'sv-SE',
  description,
};
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [websiteSchema, ...pageSchemas];
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Apply the card/list view before first paint (avoids layout shift). A saved
        choice wins on any screen; with no choice, mobile defaults to cards. */}
    <script is:inline>
      try {
        var v = localStorage.getItem('sommarpratet:view');
        var cards = v === 'cards' || (v !== 'list' && window.matchMedia('(max-width: 640px)').matches);
        if (cards) document.documentElement.dataset.cards = '1';
      } catch (e) {}
    </script>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Geist.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Sommarpratet – årets sommarpratare i Sommar i P1" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Hoppa till innehåll</a>
    <main id="main" class={styles.main}>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class={styles.footer}>
      <div class="container">
        <div class={styles.footerInner}>
          <p class={styles.footerText}>
            Av <a href="https://urre.me" target="_blank" rel="noopener">Urban Sandén</a>
            · Källa:
            <a href="https://www.sverigesradio.se/artikel/sommarpratare-2026-hela-listan" target="_blank" rel="noopener">Sveriges Radio</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
