---
// Sticky bottom podcast player for episodes that have already aired.
//
// The MP3 is *not* baked in at build time: it's resolved on first play from
// Sveriges Radio's open API (api.sr.se, CORS-open) via the episode id in each
// host's `sr` URL. SR's season audio expires (mid-September) and files get
// re-published, so a build-time URL would go stale silently — this always asks
// for the current one and falls back to the SR link if there is none.
import styles from './Player.module.css';

const ICON = {
  play: '<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>',
  pause:
    '<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>',
  back: '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4 4 9l7 5V4z"/><path d="M4 9h9a7 7 0 1 1 0 14H8"/></svg>',
  forward:
    '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4l7 5-7 5V4z"/><path d="M20 9h-9a7 7 0 1 0 0 14h5"/></svg>',
  close:
    '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
};
---

<div class={styles.bar} data-player hidden>
  <audio data-audio preload="none"></audio>

  <div class={styles.inner}>
    <div class={styles.host}>
      <img class={styles.cover} data-cover width="44" height="44" alt="" hidden />
      <span class={styles.hostText}>
        <span class={styles.hostName} data-player-name></span>
        <span class={styles.hostMeta} data-player-meta></span>
      </span>
    </div>

    <div class={styles.controls}>
      <button type="button" class={styles.skipBtn} data-back aria-label="Hoppa 15 sekunder bakåt" disabled>
        <Fragment set:html={ICON.back} />
      </button>
      <button type="button" class={styles.playBtn} data-toggle aria-label="Spela">
        <Fragment set:html={ICON.play} />
      </button>
      <button type="button" class={styles.skipBtn} data-forward aria-label="Hoppa 15 sekunder framåt" disabled>
        <Fragment set:html={ICON.forward} />
      </button>
    </div>

    <div class={styles.seek} data-seek>
      <span class={styles.time} data-current>0:00</span>
      <label class="visually-hidden" for="sp-seek">Spola i avsnittet</label>
      <input
        id="sp-seek"
        class={styles.range}
        data-range
        type="range"
        min="0"
        max="100"
        step="1"
        value="0"
        disabled
      />
      <span class={styles.time} data-duration>–:––</span>
    </div>

    <p class={styles.status} data-status role="status" hidden></p>

    <button type="button" class={styles.closeBtn} data-close aria-label="Stäng spelaren">
      <Fragment set:html={ICON.close} />
    </button>
  </div>
</div>

<script>
  const API = 'https://api.sr.se/api/v2/episodes/get?format=json&id=';
  const SKIP = 15;

  const PLAY_ICON =
    '<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
  const PAUSE_ICON =
    '<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>';
  const SPINNER =
    '<svg class="sp-spin" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9" /></svg>';
  // Row-level icons (18px, to match the other action icons in the table).
  const ROW_PLAY =
    '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
  const ROW_PAUSE =
    '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>';

  function fmt(sec: number) {
    if (!Number.isFinite(sec) || sec < 0) return '–:––';
    const s = Math.floor(sec % 60);
    const m = Math.floor(sec / 60) % 60;
    const h = Math.floor(sec / 3600);
    const mm = String(m).padStart(h ? 2 : 1, '0');
    return (h ? h + ':' : '') + mm + ':' + String(s).padStart(2, '0');
  }

  function initPlayer() {
    const barEl = document.querySelector<HTMLElement>('[data-player]');
    const audioEl = barEl?.querySelector<HTMLAudioElement>('[data-audio]');
    if (!barEl || !audioEl) return;
    // Rebound as non-nullable so the narrowing survives into the closures below.
    const bar: HTMLElement = barEl;
    const audio: HTMLAudioElement = audioEl;

    const cover = bar.querySelector<HTMLImageElement>('[data-cover]');
    const nameEl = bar.querySelector<HTMLElement>('[data-player-name]');
    const metaEl = bar.querySelector<HTMLElement>('[data-player-meta]');
    const toggle = bar.querySelector<HTMLButtonElement>('[data-toggle]');
    const backBtn = bar.querySelector<HTMLButtonElement>('[data-back]');
    const fwdBtn = bar.querySelector<HTMLButtonElement>('[data-forward]');
    const range = bar.querySelector<HTMLInputElement>('[data-range]');
    const curEl = bar.querySelector<HTMLElement>('[data-current]');
    const durEl = bar.querySelector<HTMLElement>('[data-duration]');
    const seek = bar.querySelector<HTMLElement>('[data-seek]');
    const statusEl = bar.querySelector<HTMLElement>('[data-status]');
    const closeBtn = bar.querySelector<HTMLButtonElement>('[data-close]');

    /** Resolved MP3 urls, keyed by SR episode id — one API call per episode. */
    const resolved = new Map<string, { url: string; duration: number } | null>();
    let episode: string | null = null; // the episode currently loaded
    let scrubbing = false;
    let loadToken = 0; // guards against a slow fetch landing after a newer click

    function setStatus(msg: string) {
      if (!statusEl || !seek) return;
      statusEl.textContent = msg;
      statusEl.hidden = !msg;
      seek.hidden = !!msg;
    }

    /** Reflect play/pause across the bar button, the row button and the row tint. */
    function syncPlaying() {
      const playing = !audio.paused && !audio.ended && !!episode;
      if (toggle) {
        toggle.innerHTML = playing ? PAUSE_ICON : PLAY_ICON;
        toggle.setAttribute('aria-label', playing ? 'Pausa' : 'Spela');
      }
      for (const btn of Array.from(document.querySelectorAll<HTMLButtonElement>('[data-play]'))) {
        const active = btn.dataset.episode === episode;
        btn.innerHTML = active && playing ? ROW_PAUSE : ROW_PLAY;
        btn.setAttribute('aria-pressed', active && playing ? 'true' : 'false');
        const row = btn.closest<HTMLElement>('[data-row]');
        if (row) {
          if (active) row.dataset.playing = playing ? 'true' : 'paused';
          else delete row.dataset.playing;
        }
      }
      if ('mediaSession' in navigator) {
        navigator.mediaSession.playbackState = playing ? 'playing' : 'paused';
      }
    }

    function setLoading(on: boolean) {
      if (!toggle) return;
      if (on) {
        toggle.innerHTML = SPINNER;
        toggle.setAttribute('aria-label', 'Laddar');
      } else {
        syncPlaying();
      }
    }

    function openBar(name: string, meta: string, image: string) {
      bar.hidden = false;
      document.documentElement.dataset.playerOpen = '1';
      if (nameEl) nameEl.textContent = name;
      if (metaEl) metaEl.textContent = meta;
      if (cover) {
        if (image) {
          cover.src = image;
          cover.alt = name;
          cover.hidden = false;
        } else {
          cover.hidden = true;
        }
      }
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: name,
          artist: 'Sommar i P1',
          album: 'Sveriges Radio P1',
          artwork: image ? [{ src: new URL(image, location.href).href, sizes: '512x512', type: 'image/webp' }] : [],
        });
      }
    }

    function closeBar() {
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      episode = null;
      bar.hidden = true;
      delete document.documentElement.dataset.playerOpen;
      syncPlaying();
    }

    /** Look the episode's podcast file up in SR's open API (cached per episode). */
    async function lookup(id: string) {
      if (resolved.has(id)) return resolved.get(id) ?? null;
      try {
        const res = await fetch(API + encodeURIComponent(id));
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const file = data?.episode?.listenpodfile ?? data?.episode?.downloadpodfile;
        const hit = file?.url ? { url: file.url as string, duration: Number(file.duration) || 0 } : null;
        resolved.set(id, hit);
        return hit;
      } catch (e) {
        return null; // not cached — a transient failure should be retryable
      }
    }

    async function play(btn: HTMLElement) {
      const id = btn.dataset.episode;
      if (!id) return;
      const name = btn.dataset.host ?? '';
      const meta = btn.dataset.meta ?? 'Sommar i P1';
      const image = btn.dataset.image ?? '';

      // Same episode already loaded → just toggle.
      if (episode === id && audio.src) {
        if (audio.paused) void audio.play();
        else audio.pause();
        return;
      }

      openBar(name, meta, image);
      setStatus('');
      const token = ++loadToken;
      setLoading(true);
      const hit = await lookup(id);
      if (token !== loadToken) return; // a newer click won
      if (!hit) {
        episode = null;
        setLoading(false);
        setStatus('Avsnittet går inte att spela här just nu – lyssna hos Sveriges Radio.');
        return;
      }

      episode = id;
      audio.src = hit.url;
      if (range && hit.duration) {
        range.max = String(hit.duration);
        range.disabled = false;
      }
      if (durEl && hit.duration) durEl.textContent = fmt(hit.duration);
      if (backBtn) backBtn.disabled = false;
      if (fwdBtn) fwdBtn.disabled = false;
      try {
        await audio.play();
      } catch (e) {
        setLoading(false);
      }
    }

    // Delegated so it keeps working while the table re-sorts and re-appends rows.
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-play]');
      if (btn) void play(btn);
    });

    toggle?.addEventListener('click', () => {
      if (!episode) return;
      if (audio.paused) void audio.play();
      else audio.pause();
    });
    backBtn?.addEventListener('click', () => {
      audio.currentTime = Math.max(0, audio.currentTime - SKIP);
    });
    fwdBtn?.addEventListener('click', () => {
      audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + SKIP);
    });
    closeBtn?.addEventListener('click', closeBar);

    range?.addEventListener('pointerdown', () => {
      scrubbing = true;
    });
    range?.addEventListener('pointerup', () => {
      scrubbing = false;
    });
    range?.addEventListener('input', () => {
      const t = Number(range.value);
      if (curEl) curEl.textContent = fmt(t);
      if (Number.isFinite(audio.duration) || t <= (audio.duration || 0)) audio.currentTime = t;
    });

    audio.addEventListener('loadedmetadata', () => {
      if (range && Number.isFinite(audio.duration)) {
        range.max = String(Math.floor(audio.duration));
        range.disabled = false;
      }
      if (durEl) durEl.textContent = fmt(audio.duration);
    });
    audio.addEventListener('timeupdate', () => {
      if (curEl) curEl.textContent = fmt(audio.currentTime);
      if (range && !scrubbing) range.value = String(Math.floor(audio.currentTime));
    });
    audio.addEventListener('playing', () => setLoading(false));
    audio.addEventListener('play', syncPlaying);
    audio.addEventListener('pause', syncPlaying);
    audio.addEventListener('ended', syncPlaying);
    audio.addEventListener('error', () => {
      if (!audio.src) return;
      setLoading(false);
      setStatus('Ljudet kunde inte spelas – lyssna hos Sveriges Radio.');
    });

    // Escape closes the player when focus is inside the bar.
    bar.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeBar();
    });

    if ('mediaSession' in navigator) {
      navigator.mediaSession.setActionHandler('play', () => void audio.play());
      navigator.mediaSession.setActionHandler('pause', () => audio.pause());
      navigator.mediaSession.setActionHandler('seekbackward', () => {
        audio.currentTime = Math.max(0, audio.currentTime - SKIP);
      });
      navigator.mediaSession.setActionHandler('seekforward', () => {
        audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + SKIP);
      });
    }

    syncPlaying();
  }

  if (document.readyState !== 'loading') initPlayer();
  else document.addEventListener('DOMContentLoaded', initPlayer);
</script>

<style is:global>
  /* The spinner class lives on an SVG injected by the script, so it can't be a
     CSS-module class name. */
  .sp-spin {
    animation: sp-spin 0.8s linear infinite;
  }
  @keyframes sp-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
